#!ipxe
set root_path /pxeboot
set mac_addr ${netX/mac}
set menu-timeout 180000

:start
menu Select an OS to boot
item --gap --           -------------------- Choose installations --------------------
{% for item in config["menus"] -%}
item {{ item["id"] }} {{ item["menu_text"] }}
{% endfor -%}
item --gap --           ---------------------- Advanced options ----------------------
item --key c config     Configure settings
item shell              Drop to iPXE shell
item reboot             Reboot Computer
choose --default exit --timeout ${menu-timeout} option || goto cancel
goto ${option}

{%- for item in config["menus"] -%}
{% if item["id"].startswith('ubuntu-') %}
:{{ item["id"] }}
set image_name_prefix {{ config["images"][item["image_id"]]["url"] | basename | regex_replace('\\.iso$', '') }}
kernel http://${next-server}/os/images/${image_name_prefix}/casper/vmlinuz
initrd http://${next-server}/os/images/${image_name_prefix}/casper/initrd
{% if (item["custom_imgargs"] is not defined or item["custom_imgargs"] == None or item["custom_imgargs"] == '') -%}
imgargs vmlinuz initrd=initrd autoinstall ip=dhcp BOOTIF=01-${netX/mac:hexhyp} url=http://${next-server}/os/images/${image_name_prefix}.iso ds=nocloud-net;s=http://${next-server}/os/autoinstall/${mac_addr}/ ---
{%- else -%}
{{ item["custom_imgargs"] }}
{%- endif %}
boot
{%- endif %}
{% endfor %}

:exit
exit

:config
config
goto start

:cancel
echo You cancelled the menu, dropping you to a shell

:shell
echo Type 'exit' to get the back to the menu
shell
set menu-timeout 0
goto start

:reboot
reboot
